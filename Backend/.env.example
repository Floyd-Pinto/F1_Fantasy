# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (local Docker, or a free Neon database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/f1fantasy

# Token signing secrets — required when NODE_ENV=production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Common ──────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated allowed frontend origins (empty = allow all; development only)
CORS_ORIGIN=http://localhost:5173

# Created (or promoted) as an admin by `npm run seed` / `npm run db:setup`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

# ── Optional ────────────────────────────────────────────────────────────────
# Database the integration tests wipe and use (name must contain "test")
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/f1_test

# Web Push (lock reminders). If unset, a key pair is generated once and stored in the database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# One-time first-admin bootstrap via POST /admin/boot/:userId
# ADMIN_BOOT_TOKEN=

# REAL_DATA_SYNC=false    # disable the scheduled Jolpica/OpenF1 sync, results watcher and replay cache
# SYNC_CRON=17 */6 * * *  # schedule of the full data sync
# AUTH_RATE_LIMIT=20      # login/register attempts per 15 min per IP
# SIM_LAPS=30             # laps in a simulated test race
# SIM_LAP_MS=3000         # ms per simulated lap
